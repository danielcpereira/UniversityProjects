{
  "name": "jdbc-cinema-sink",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "connection.url": "jdbc:postgresql://database:5432/project3?user=postgres&password=nopass",
    "dialect.name": "PostgreSqlDatabaseDialect",
    "tasks.max": "1",
    "topics": "CinemaRevenuePerFilm,CinemaExpensesPerFilm,CinemaProfitPerFilm,CinemaTotalRevenue,CinemaTotalExpenses,CinemaTotalProfit,CinemaAvgTransactionPerFilm,CinemaAvgTransactionAllFilms,CinemaHighestProfitFilm,CinemaRevenueLastHour,CinemaExpensesLastHour,CinemaProfitLastHour,CinemaTopGenrePerFilm",
    "auto.create": "false",
    "insert.mode": "upsert",
    "pk.mode": "record_value",
    "pk.fields": "id",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
